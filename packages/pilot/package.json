{
  "name": "@ycforge/pilot",
  "version": "1.0.1",
  "description": "Build/Deployment Orchestrator (Project C) for the serverless-tools ecosystem. Plugin contracts are exposed via the @ycforge/pilot/contracts subpath export.",
  "license": "MIT",
  "author": "ycforge (https://github.com/ycforge)",
  "homepage": "https://github.com/ycforge/serverless-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycforge/serverless-tools.git",
    "directory": "packages/pilot"
  },
  "bugs": {
    "url": "https://github.com/ycforge/serverless-tools/issues"
  },
  "keywords": [
    "yandex-cloud",
    "serverless",
    "deployment",
    "orchestrator",
    "terraform",
    "build",
    "cli",
    "ycforge"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "pnpm --filter @ycforge/builders-core build && pnpm --filter @ycforge/materializers-core build && pnpm build && pnpm --filter @ycforge/composer build",
    "test": "vitest run",
    "typecheck": "pnpm --filter @ycforge/builders-core build && pnpm --filter @ycforge/materializers-core build && tsc --noEmit"
  },
  "bin": {
    "ycsf": "dist/cli/index.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@ycforge/builders-core": "workspace:*",
    "@ycforge/materializers-core": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
