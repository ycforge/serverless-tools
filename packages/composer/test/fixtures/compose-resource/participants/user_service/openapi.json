{
  "openapi": "3.0.0",
  "info": { "title": "user_service", "version": "1.0.0" },
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "security": [{ "user": [] }],
        "responses": { "200": { "description": "list of users" } }
      },
      "post": {
        "operationId": "createUser",
        "security": [{ "user": [] }],
        "responses": { "201": { "description": "created" } }
      }
    },
    "/users/{id}": {
      "get": {
        "operationId": "getUser",
        "security": [{ "user": [] }],
        "responses": { "200": { "description": "a user" } }
      }
    },
    "/legacy": {
      "get": {
        "operationId": "listLegacy",
        "security": [{ "user": [] }],
        "responses": { "200": { "description": "legacy list" } }
      }
    }
  },
  "components": {
    "schemas": {
      "UserDto": {
        "type": "object",
        "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
      }
    }
  }
}