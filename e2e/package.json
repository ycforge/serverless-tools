{
  "name": "@ycforge/cloud-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloud e2e harness (spec 037): deploys a dedicated test project to Yandex Cloud and asserts live behaviour of the serverless-tools toolchain.",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "e2e": "node scripts/vendor-connector.mjs && vitest run",
    "e2e:watch": "vitest",
    "e2e:typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/microservices": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "@ycforge/builders-core": "link:../packages/builders-core",
    "@ycforge/composer": "link:../packages/composer",
    "@ycforge/materializers-core": "link:../packages/materializers-core",
    "@ycforge/nestjs-connector": "link:../packages/nest-bridge",
    "@ycforge/pilot": "link:../packages/pilot",
    "@yandex-cloud/nodejs-sdk": "3.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@types/node": "^22.20.1",
    "jose": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.0",
    "vite": "^7.3.6"
  }
}
