{
  "openapi": "3.0.0",
  "info": { "title": "openapi-app", "version": "1.0.0" },
  "security": [{ "user": [] }],
  "paths": {
    "/users": {
      "get": { "security": [{ "user": [] }] },
      "post": { "security": [{ "user": [] }] }
    },
    "/ping": { "get": {} },
    "/internal": { "get": { "security": [{ "internal": [] }] } }
  },
  "components": {
    "securitySchemes": { "ignored": { "type": "apiKey", "name": "x-api-key", "in": "header" } }
  }
}